<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MoMo Café | Luxury Dining Hyderabad</title>
  <style>
    :root {
      --primary: #1a1a1a;
      --accent: #d4af37;
      --glass: rgba(255, 255, 255, 0.05);
      --text: #f8f9fa;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Segoe UI", Roboto, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0c0c0c 0%, #1a1a1a 100%);
      color: var(--text);
      overflow-x: hidden;
      perspective: 1000px;
      height: 100vh;
    }

    /* 3D Scene Container */
    .scene {
      width: 100vw;
      height: 100vh;
      perspective: 1200px;
      perspective-origin: center center;
    }

    /* 3D Floating Background Elements */
    .bg-elements {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
    }

    .glow-orb {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
      filter: blur(40px);
      animation: orbit 25s infinite linear;
    }

    .glow-orb:nth-child(1) { width: 300px; height: 300px; top: 10%; left: 10%; animation-duration: 30s; }
    .glow-orb:nth-child(2) { width: 200px; height: 200px; top: 60%; right: 10%; animation-duration: 40s; animation-direction: reverse; }
    .glow-orb:nth-child(3) { width: 150px; height: 150px; bottom: 20%; left: 20%; animation-duration: 35s; }

    @keyframes orbit {
      0% { transform: rotateY(0deg) translateX(200px) rotateY(0deg) scale(1); }
      100% { transform: rotateY(360deg) translateX(200px) rotateY(-360deg) scale(1.1); }
    }

    /* 3D Navigation */
    .nav-3d {
      position: fixed;
      top: 30px;
      left: 50%;
      transform: translateX(-50%) translateZ(100px);
      padding: 20px 40px;
      background: rgba(26, 26, 26, 0.9);
      backdrop-filter: blur(20px);
      border-radius: 50px;
      border: 1px solid rgba(212, 175, 55, 0.3);
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 90%;
      max-width: 500px;
      z-index: 1000;
      transition: transform 0.5s;
    }

    .nav-3d:hover {
      transform: translateX(-50%) translateZ(150px) rotateX(10deg);
    }

    .logo-3d {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: 3px;
      color: var(--accent);
      text-shadow: 0 0 20px var(--accent);
    }

    /* 3D Hero Section */
    .hero-3d {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      transform-style: preserve-3d;
      animation: heroFloat 6s ease-in-out infinite;
    }

    @keyframes heroFloat {
      0%, 100% { transform: translateZ(0px) rotateX(0deg); }
      50% { transform: translateZ(50px) rotateX(5deg); }
    }

    .hero-title {
      font-size: 5rem;
      text-transform: uppercase;
      letter-spacing: 8px;
      background: linear-gradient(45deg, var(--accent), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      transform: translateZ(80px);
      animation: titleGlow 3s ease-in-out infinite alternate;
      margin-bottom: 20px;
    }

    @keyframes titleGlow {
      from { filter: drop-shadow(0 0 20px var(--accent)); }
      to { filter: drop-shadow(0 0 40px var(--accent)); }
    }

    .hero-subtitle {
      font-size: 1.5rem;
      color: var(--accent);
      margin-bottom: 40px;
      transform: translateZ(60px);
    }

    /* 3D Button */
    .btn-3d {
      padding: 20px 50px;
      border: 2px solid var(--accent);
      background: transparent;
      color: var(--accent);
      text-transform: uppercase;
      cursor: pointer;
      font-weight: 700;
      letter-spacing: 2px;
      transform: translateZ(40px) rotateX(15deg);
      transition: all 0.4s;
      position: relative;
      text-decoration: none;
    }

    .btn-3d:hover {
      background: var(--accent);
      color: var(--primary);
      transform: translateZ(80px) rotateX(0deg) scale(1.1);
      box-shadow: 0 20px 40px rgba(212, 175, 55, 0.4);
    }

    /* 3D Info Grid */
    .info-container-3d {
      padding: 100px 10%;
      transform-style: preserve-3d;
      perspective: 1000px;
    }

    .cards-wrapper {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      gap: 40px;
      transform-style: preserve-3d;
    }

    .card-3d {
      width: 320px;
      height: 280px;
      background: linear-gradient(145deg, var(--glass), rgba(255,255,255,0.1));
      padding: 40px;
      border-radius: 25px;
      border: 1px solid rgba(212, 175, 55, 0.2);
      transform: rotateY(0deg) rotateX(0deg) translateZ(0px);
      transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .card-3d::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.1), transparent);
      transition: left 0.5s;
    }

    .card-3d:hover::before {
      left: 100%;
    }

    .card-3d:hover {
      transform: rotateY(10deg) rotateX(10deg) translateZ(80px) translateY(-20px);
      box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 40px rgba(212, 175, 55, 0.3);
      border-color: var(--accent);
    }

    .card-3d h3 {
      color: var(--accent);
      margin-bottom: 20px;
      font-size: 1.8rem;
      text-shadow: 0 0 10px var(--accent);
    }

    /* 3D Footer */
    .footer-3d {
      padding: 80px 10%;
      background: rgba(13, 13, 13, 0.95);
      text-align: center;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
      transform: translateZ(-50px);
      margin-top: 100px;
    }

    .address-3d {
      font-size: 1.2rem;
      margin-bottom: 20px;
      transform: rotateX(-10deg);
    }

    /* Scroll-triggered 3D animations */
    .scroll-section {
      opacity: 0;
      transform: translateZ(-200px) rotateX(90deg);
      transition: all 1s ease;
    }

    .scroll-section.visible {
      opacity: 1;
      transform: translateZ(0px) rotateX(0deg);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero-title { font-size: 3rem; letter-spacing: 3px; }
      .cards-wrapper { flex-direction: column; align-items: center; }
      .nav-3d { flex-direction: column; gap: 15px; width: 95%; }
    }

    /* Parallax Mouse Effect */
    body.moving .hero-3d {
      transition: transform 0.1s ease-out;
    }
  </style>
</head>
<body>
  <div class="bg-elements">
    <div class="glow-orb"></div>
    <div class="glow-orb"></div>
    <div class="glow-orb"></div>
  </div>

  <div class="scene">
    <nav class="nav-3d">
      <div class="logo-3d">MOMO CAFÉ</div>
      <a href="tel:+914066522222" class="btn-3d">Book Table</a>
    </nav>

    <section class="hero-3d">
      <h1 class="hero-title">Refined Flavors</h1>
      <p class="hero-subtitle">International Buffet & Regional Excellence</p>
      <a href="#about" class="btn-3d">Explore Experience</a>
    </section>

    <section class="info-container-3d scroll-section" id="about">
      <div class="cards-wrapper">
        <div class="card-3d">
          <h3>🕒 Timings</h3>
          <p>Open until 4:00 PM</p>
          <p>Evening: 7:00 PM - 11:30 PM</p>
          <p style="margin-top: 15px; font-style: italic; color: #ccc">
            Breakfast, Lunch, Dinner, & Brunch
          </p>
        </div>

        <div class="card-3d">
          <h3>🍽️ Cuisine & Dietary</h3>
          <p>Western to Regional Indian</p>
          <p>Vegetarian • Vegan • Halal • Kosher • Gluten Free</p>
        </div>

        <div class="card-3d">
          <h3>🅿️ Amenities</h3>
          <p>Valet Parking Available</p>
          <p>Validated Parking</p>
          <p>Accepts All Major Credit Cards</p>
        </div>
      </div>
    </section>

    <footer class="footer-3d scroll-section">
      <div class="address-3d">
        1-3-1024 Lower Tank Bund Road, Courtyard Hyderabad
      </div>
      <div style="font-size: 1rem; opacity: 0.8;">
        <p>Hyderabad 500080 India</p>
        <p>📞 T: +91 40 6652 2222</p>
      </div>
    </footer>
  </div>

  <script>
    // Mouse parallax effect
    document.addEventListener('mousemove', (e) => {
      const mouseX = e.clientX / window.innerWidth;
      const mouseY = e.clientY / window.innerHeight;
      
      document.body.classList.add('moving');
      document.querySelector('.hero-3d').style.transform = `
        translateZ(0px) 
        rotateY(${mouseX * 20 - 10}deg) 
        rotateX(${mouseY * -10 + 5}deg)
      `;
    });

    // Scroll animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    });

    document.querySelectorAll('.scroll-section').forEach(el => {
      observer.observe(el);
    });

    // Smooth scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        document.querySelector(this.getAttribute('href')).scrollIntoView({
          behavior: 'smooth'
        });
      });
    });
  </script>
</body>
</html>
